    <string name="method_card_title">Metode Algoritma Prediksi</string>
    <string name="method_mlr_heading">1. Multiple Linear Regression (MLR)</string>
    <string name="method_prediction">Prediksi</string>
    <string name="method_mlr_description">Memprediksi nilai permintaan OAT pada formulir LPLPO untuk bulan setelah periode pencatatan, berdasarkan data pada formulir.</string>
    <string name="method_mlr_equation">Y = β₀ + β₁X₁ + … + βₚXₚ + e</string>
    <string name="method_target">Target (Y): Kebutuhan / Permintaan OAT Bulan Mendatang</string>
    <string name="method_variables">VARIABEL PADA FORMULIR LPLPO:</string>
    <string name="method_x1">X₁ = Nama Puskesmas</string>
    <string name="method_x2">X₂ = Pemakaian</string>
    <string name="method_x3">X₃ = Sisa Stok</string>
    <string name="method_x4">X₄ = Penerimaan</string>
    <string name="method_x5">X₅ = Kasus Baru TBC</string>
    <string name="method_x6">X₆ = Pasien TBC</string>
    <string name="method_x7">X₇ = Permintaan formulir bulan sebelumnya (t−1)</string>
    <string name="method_tree_heading">2. Decision Tree</string>
    <string name="method_classification">Klasifikasi</string>
    <string name="method_tree_description">Mengklasifikasikan tingkat kebutuhan stok ke dalam kategori status (Rendah, Sedang, Tinggi) melalui pemetaan pohon keputusan berdasarkan ambang batas persediaan.</string>
    <string name="method_gini_equation">Gini(S) = 1 − Σᵢ pᵢ²</string>
    <string name="method_legend">Keterangan:</string>
    <string name="method_gini_meaning">• Gini(S) = Nilai Gini Impurity pada dataset S</string>
    <string name="method_proportion_meaning">• pᵢ = Proporsi data yang termasuk ke dalam kelas ke-i</string>
    <string name="method_index_meaning">• i = Indeks kelas pada dataset</string>
    <string name="method_illustration_note">Rumus pada kartu adalah ilustrasi umum, bukan persamaan fitur akhir. X₂ (kategori OAT) tetap pada dataset dan tidak digunakan sebagai fitur karena penelitian ini memakai satu kategori.</string>
    <string name="method_research_note">Untuk formulir periode t, X₃–X₆ berasal dari formulir t, X₇ berasal dari kolom Permintaan formulir t−1, dan Y adalah kolom Permintaan pada formulir t untuk bulan t+1. MLR dan CART adalah model terpisah.</string>
